APP_NAME=LicenseVault
APP_ENV=production
APP_DEBUG=false
APP_URL=https://licensevault.example.local
# Reverse Proxy: vertrauenswürdige Proxy-IPs/CIDRs (kommagetrennt, "*" = alle). Leer lassen = private Netze.
# TRUSTED_PROXIES=
APP_KEY=
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Datenbank – Modus A: DB_HOST=db | Modus B: Adresse der vorhandenen Instanz
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=licensevault
DB_USERNAME=licensevault
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Deployment
DATA_DIR=/mnt/user/appdata/licensevault
WEB_PORT=8080
PUID=99
PGID=100
RUN_MIGRATIONS=false

REMINDER_DAYS=30,7,1

# Backup (Pflicht für Sicherungen): mind. 12 Zeichen, getrennt von APP_KEY und DB-Passwort sichern
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
BACKUP_TIME=03:00

# Benachrichtigungen bei fälligen Lizenzen (beide Kanäle optional)
# Web-Push (iPhone-PWA, iOS 16.4+): Schlüssel erzeugen mit `php artisan licensevault:vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com
# Gotify (selbst gehosteter Push-Server): URL und App-Token
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
